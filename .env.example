# ==========================================
# meanwhile — Environment Variables
# ==========================================

# Supabase Configuration
# Obtain these from your Supabase project dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Advertising Configuration (Future-Proof Monetization)
# When set to 'false' (default), ad slots are gracefully hidden with 0 layout shift.
# In development/test mode, setting to 'true' displays subtle branded placeholders.
VITE_ENABLE_ADS=false
VITE_AD_CLIENT_ID=ca-pub-0000000000000000

# Optional Application Metadata
VITE_APP_URL=https://meanwhile.vercel.app
